<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="create-listing-page">

    <section class="create-header">

        <div>

            <h1>Create a New Listing</h1>

            <p>
                Add your asset and start earning from trusted renters.
            </p>

        </div>

    </section>

    <form
        action="/listings/create"
        method="POST"
        enctype="multipart/form-data"
        class="listing-form"
    >

        <div class="listing-layout">

            <!-- Left -->

            <div class="listing-main">

                <div class="form-card">

                    <h2>Basic Information</h2>

                    <div class="form-group">

                        <label>Asset Title</label>

                        <input
                            type="text"
                            name="title"
                            minlength="3"
                            maxlength="100"
                            placeholder="e.g. Toyota Prado TX"
                            required
                        >

                    </div>

                    <div class="form-row">

                        <div class="form-group">

                            <label>Category</label>

                            <select
                                name="category"
                                required
                            >

                                <option value="">Select Category</option>

                                <option>Property</option>
                                <option>Vehicle</option>
                                <option>Electronics</option>
                                <option>Furniture</option>
                                <option>Tools</option>
                                <option>Equipment</option>
                                <option>Livestock</option>
                                <option>Other</option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Price Per Day (KES)</label>

                            <input
                                type="number"
                                name="price_per_day"
                                min="0.01"
                                step="0.01"
                                placeholder="2500"
                                required
                            >

                        </div>

                    </div>

                    <div class="form-group">

                        <label>Location</label>

                        <input
                            type="text"
                            name="location"
                            minlength="2"
                            maxlength="100"
                            placeholder="Nairobi"
                            required
                        >

                    </div>

                    <div class="form-group">

                        <label>Description</label>

                        <textarea
                            name="description"
                            rows="8"
                            maxlength="2000"
                            placeholder="Describe your asset..."
                        ></textarea>

                    </div>

                </div>

            </div>

            <!-- Right -->

            <aside class="listing-sidebar">

                <div class="form-card">

                    <h2>Photos</h2>

                    <label class="upload-box">

                        <input
                            type="file"
                            name="image"
                            accept="image/jpeg,image/png,image/webp"
                        >

                        <div class="upload-content">

                            <span>📷</span>

                            <h3>Upload Photo</h3>

                            <p>

                                PNG, JPG or WebP (max 5 MB)

                            </p>

                        </div>

                    </label>

                </div>

                <div class="form-card">

                    <button
                        type="submit"
                        class="publish-btn"
                    >

                        Publish Listing

                    </button>

                </div>

            </aside>

        </div>

    </form>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>