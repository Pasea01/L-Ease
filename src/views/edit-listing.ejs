<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="create-listing-page">

    <section class="create-header">

        <div>

            <h1>Edit Listing</h1>

            <p>
                Update your listing details and keep your information up to date.
            </p>

        </div>

    </section>

    <form
        action="/listings/edit/<%= listing.id %>"
        method="POST"
        enctype="multipart/form-data"
        class="listing-form"
    >

        <div class="listing-layout">

            <!-- Left -->

            <div class="listing-main">

                <div class="form-card">

                    <h2>Listing Information</h2>

                    <div class="form-group">

                        <label>Asset Title</label>

                        <input
                            type="text"
                            name="title"
                            value="<%= listing.title %>"
                            minlength="3"
                            maxlength="100"
                            required
                        >

                    </div>

                    <div class="form-row">

                        <div class="form-group">

                            <label>Category</label>

                            <select
                                name="category"
                                required
                            >

                                <option value="Property" <%= listing.category==="Property"?"selected":"" %>>Property</option>

                                <option value="Vehicle" <%= listing.category==="Vehicle"?"selected":"" %>>Vehicle</option>

                                <option value="Electronics" <%= listing.category==="Electronics"?"selected":"" %>>Electronics</option>

                                <option value="Furniture" <%= listing.category==="Furniture"?"selected":"" %>>Furniture</option>

                                <option value="Tools" <%= listing.category==="Tools"?"selected":"" %>>Tools</option>

                                <option value="Equipment" <%= listing.category==="Equipment"?"selected":"" %>>Equipment</option>

                                <option value="Livestock" <%= listing.category==="Livestock"?"selected":"" %>>Livestock</option>

                                <option value="Other" <%= listing.category==="Other"?"selected":"" %>>Other</option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Price Per Day (KES)</label>

                            <input
                                type="number"
                                name="price_per_day"
                                value="<%= listing.price_per_day %>"
                                min="0.01"
                                step="0.01"
                                required
                            >

                        </div>

                    </div>

                    <div class="form-group">

                        <label>Location</label>

                        <input
                            type="text"
                            name="location"
                            value="<%= listing.location %>"
                            minlength="2"
                            maxlength="100"
                            required
                        >

                    </div>

                    <div class="form-group">

                        <label>Description</label>

                        <textarea
                            name="description"
                            rows="8"
                            maxlength="2000"
                            required
                        ><%= listing.description %></textarea>

                    </div>

                </div>

            </div>

            <!-- Right -->

            <aside class="listing-sidebar">

                <div class="form-card">

                    <h2>Listing Image</h2>

                    <label class="listing-image-editor">

                        <% if (listing.image_url) { %>

                            <img
                                src="<%= getListingImage(listing) %>"
                                class="current-image"
                                id="listing-image-preview"
                                alt="<%= listing.title %>"
                                onerror="this.onerror=null; this.src='<%= getCategoryImage(listing.category) %>';"
                            >

                        <% } else { %>

                            <img
                                src="<%= getCategoryImage(listing.category) %>"
                                class="current-image"
                                id="listing-image-preview"
                                alt="<%= listing.category %>"
                            >

                        <% } %>

                        <input
                            type="file"
                            name="image"
                            id="listing-image-input"
                            aria-label="Change listing image"
                            accept="image/jpeg,image/png,image/webp"
                        >

                        <span class="listing-image-change">

                            <span aria-hidden="true">📷</span>

                            <span>Change image</span>

                        </span>

                    </label>

                    <p class="listing-image-help" id="listing-image-status" aria-live="polite">
                        Select an image to preview it. JPG, PNG or WebP, up to 5 MB.
                    </p>

                </div>

                <div class="form-card">

                    <button
                        type="submit"
                        class="publish-btn"
                    >

                        Save Changes

                    </button>

                </div>

            </aside>

        </div>

    </form>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

<script>
const listingImageInput = document.getElementById("listing-image-input");
const listingImagePreview = document.getElementById("listing-image-preview");
const listingImageStatus = document.getElementById("listing-image-status");
let listingImagePreviewUrl;

listingImageInput?.addEventListener("change", () => {
    const file = listingImageInput.files?.[0];

    if (!file) {
        return;
    }

    if (listingImagePreviewUrl) {
        URL.revokeObjectURL(listingImagePreviewUrl);
    }

    listingImagePreviewUrl = URL.createObjectURL(file);
    listingImagePreview.src = listingImagePreviewUrl;
    listingImageStatus.textContent = `Selected: ${file.name}`;
});
</script>

</body>
</html>