<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="create-listing-page">

    <section class="create-header">

        <div>

            <h1>Edit Listing</h1>

            <p>
                Update your listing details and keep your information up to date.
            </p>

        </div>

    </section>

    <form
        action="/listings/edit/<%= listing.id %>"
        method="POST"
        enctype="multipart/form-data"
        class="listing-form"
    >

        <div class="listing-layout">

            <!-- Left -->

            <div class="listing-main">

                <div class="form-card">

                    <h2>Listing Information</h2>

                    <div class="form-group">

                        <label>Asset Title</label>

                        <input
                            type="text"
                            name="title"
                            value="<%= listing.title %>"
                            required
                        >

                    </div>

                    <div class="form-row">

                        <div class="form-group">

                            <label>Category</label>

                            <select
                                name="category"
                                required
                            >

                                <option value="Property" <%= listing.category==="Property"?"selected":"" %>>Property</option>

                                <option value="Vehicle" <%= listing.category==="Vehicle"?"selected":"" %>>Vehicle</option>

                                <option value="Electronics" <%= listing.category==="Electronics"?"selected":"" %>>Electronics</option>

                                <option value="Furniture" <%= listing.category==="Furniture"?"selected":"" %>>Furniture</option>

                                <option value="Tools" <%= listing.category==="Tools"?"selected":"" %>>Tools</option>

                                <option value="Equipment" <%= listing.category==="Equipment"?"selected":"" %>>Equipment</option>

                                <option value="Other" <%= listing.category==="Other"?"selected":"" %>>Other</option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Price Per Day (KES)</label>

                            <input
                                type="number"
                                name="price_per_day"
                                value="<%= listing.price_per_day %>"
                                required
                            >

                        </div>

                    </div>

                    <div class="form-group">

                        <label>Location</label>

                        <input
                            type="text"
                            name="location"
                            value="<%= listing.location %>"
                            required
                        >

                    </div>

                    <div class="form-group">

                        <label>Description</label>

                        <textarea
                            name="description"
                            rows="8"
                            required
                        ><%= listing.description %></textarea>

                    </div>

                </div>

            </div>

            <!-- Right -->

            <aside class="listing-sidebar">

                <div class="form-card">

                    <h2>Current Image</h2>

                    <% if (listing.image_url) { %>

                        <img
                            src="/uploads/listings/<%= listing.image_url %>"
                            class="current-image"
                            alt="<%= listing.title %>"
                        >

                    <% } else { %>

                        <img
                            src="<%= getCategoryImage(listing.category) %>"
                            class="current-image"
                            alt="<%= listing.category %>"
                        >

                    <% } %>

                    <label class="upload-box">

                        <input
                            type="file"
                            name="image"
                            accept="image/*"
                        >

                        <div class="upload-content">

                            <span>📷</span>

                            <h3>Replace Image</h3>

                            <p>

                                Leave empty to keep the current image.

                            </p>

                        </div>

                    </label>

                </div>

                <div class="form-card">

                    <button
                        type="submit"
                        class="publish-btn"
                    >

                        Save Changes

                    </button>

                </div>

            </aside>

        </div>

    </form>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>
</html>