<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

    <header>
        <%- include("partials/navbar") %>
    </header>

    <main>

        <!-- HERO -->
        <section class="hero">

            <div class="hero-content">

                <h1>Rent Anything, Anytime.</h1>

                <p>
                    Find trusted rentals for property, vehicles,
                    electronics, furniture, tools, equipment and much more.
                </p>

                <form action="/listings" method="GET" class="hero-search">

                    <input
                        type="text"
                        name="search"
                        placeholder="What are you looking for?"
                    >

                    <select name="category">

                        <option value="">All Categories</option>
                        <option>Property</option>
                        <option>Vehicles</option>
                        <option>Electronics</option>
                        <option>Furniture</option>
                        <option>Tools</option>
                        <option>Equipment</option>
                        <option>Livestock</option>

                    </select>

                    <button type="submit">
                        Search
                    </button>

                </form>

            </div>

        </section>


        <!-- MARKET SECTION -->

        <section class="market-home">

            <aside class="category-sidebar">

                <h3>Browse Categories</h3>

                <a href="/listings?category=Property">
                    <img src="/images/categories/property.png">
                    <span>Property</span>
                </a>

                <a href="/listings?category=Vehicle">
                    <img src="/images/categories/vehicle.png">
                    <span>Vehicles</span>
                </a>

                <a href="/listings?category=Electronics">
                    <img src="/images/categories/electronics.png">
                    <span>Electronics</span>
                </a>

                <a href="/listings?category=Furniture">
                    <img src="/images/categories/furniture.png">
                    <span>Furniture</span>
                </a>

                <a href="/listings?category=Tools">
                    <img src="/images/categories/tools.png">
                    <span>Tools</span>
                </a>

                <a href="/listings?category=Equipment">
                    <img src="/images/categories/equipment.png">
                    <span>Equipment</span>
                </a>

                <a href="/listings?category=Livestock">
                    <img src="/images/categories/livestock.png">
                    <span>Livestock</span>
                </a>

                <a href="/listings?category=Other">
                    <img src="/images/categories/others.png">
                    <span>Other</span>
                </a>

            </aside>


            <div class="market-content">

                <div class="section-header">

                    <h2>Featured Assets</h2>

                    <a href="/listings">
                        View All →
                    </a>

                </div>

                <div class="listing-grid">

                    <% listings.forEach(listing => { %>

                        <a href="/listings/<%= listing.id %>" class="listing-card">

                            
                            <img
                                src="<%= getListingImage(listing) %>"
                                alt="<%= listing.title %>"
                                class="host-image"
                                onerror="this.onerror=null; this.src='<%= getCategoryImage(listing.category) %>';"
                            >

                            <div class="listing-content">

                                <h3><%= listing.title %></h3>

                                <p>📍 <%= listing.location %></p>

                                <p>👤 <%= listing.full_name %></p>

                                <div class="listing-rating">

                                    <% if (listing.review_count > 0) { %>

                                        <span class="rating-star">⭐</span>

                                        <span class="rating-score">

                                            <%= listing.average_rating %>

                                        </span>

                                        <span class="rating-count">

                                            (<%= listing.review_count %>)

                                        </span>

                                    <% } else { %>

                                        <span class="rating-none">

                                            New Listing

                                        </span>

                                    <% } %>

                                </div>

                                <div class="listing-price">

                                    KES <%= Number(listing.price_per_day).toLocaleString() %>

                                    <span>/ day</span>

                                </div>

                            </div>

                        </a>

                    <% }) %>

                </div>

            </div>

        </section>


        <!-- HOW IT WORKS -->

        <section class="how-it-works">

            <div class="section-heading">


                <h2>How L-Ease Works</h2>

                <p>

                    Leasing assets has never been easier. Follow these simple steps.

                </p>

            </div>

            <div class="steps">

                <div class="step-card">

                    <div class="step-number">

                        1

                    </div>

                    <div class="step-icon">

                        📦

                    </div>

                    <h3>List Your Asset</h3>

                    <p>

                        Create a listing, upload photos, set your rental price and
                        availability in just a few minutes.

                    </p>

                </div>

                <div class="step-arrow">

                    →

                </div>

                <div class="step-card">

                    <div class="step-number">

                        2

                    </div>

                    <div class="step-icon">

                        📩

                    </div>

                    <h3>Receive Requests</h3>

                    <p>

                        Interested renters send lease requests and communicate with you
                        through our secure messaging system.

                    </p>

                </div>

                <div class="step-arrow">

                    →

                </div>

                <div class="step-card">

                    <div class="step-number">

                        3

                    </div>

                    <div class="step-icon">

                        💰

                    </div>

                    <h3>Earn Money</h3>

                    <p>

                        Approve requests, complete leases and build your reputation
                        through verified reviews.

                    </p>

                </div>

            </div>

        </section>

        <!-- WHY CHOOSE US -->

            <section class="why-us">

                <div class="section-heading">

                    <span>Why us?</span>

                    <p>

                        Built to make leasing assets safer, easier and more reliable.

                    </p>

                </div>

                <div class="why-grid">

                    <div class="why-card">

                        <div class="why-icon">

                            🔒

                        </div>

                        <h3>Secure Leasing</h3>

                        <p>

                            rent confidently through verified accounts, secure messaging
                            and transparent agreements.

                        </p>

                    </div>

                    <div class="why-card">

                        <div class="why-icon">

                            💬

                        </div>

                        <h3>Direct Communication</h3>

                        <p>

                            Chat directly with owners or renters before making leasing
                            decisions.

                        </p>

                    </div>

                    <div class="why-card">

                        <div class="why-icon">

                            ⭐

                        </div>

                        <h3>Trusted Reviews</h3>

                        <p>

                            Build your reputation through genuine ratings from completed
                            leases.

                        </p>

                    </div>

                    <div class="why-card">

                        <div class="why-icon">

                            📅

                        </div>

                        <h3>Flexible Rentals</h3>

                        <p>

                            rent almost any asset for the duration that works for both
                            parties.

                        </p>

                    </div>

                </div>

            </section>
            <!-- TESTIMONIALS -->

                <section class="testimonials">

                    <div class="section-heading">

                        <span>Community</span>

                        <p>

                            Real experiences shared by members of the L-Ease community.

                        </p>

                    </div>

                    <% if(reviews.length === 0){ %>

                        <div class="empty-state">

                            <h3>

                                No reviews yet

                            </h3>

                            <p>

                                Complete your first lease to become one of our first reviewers.

                            </p>

                        </div>

                    <% } else { %>

                        <div class="testimonial-grid">

                            <% reviews.forEach(review=>{ %>

                                <div class="testimonial-card">

                                    <div class="testimonial-stars">

                                        <% for(let i=1;i<=5;i++){ %>

                                            <% if(i<=review.rating){ %>

                                                ⭐

                                            <% }else{ %>

                                                ☆

                                            <% } %>

                                        <% } %>

                                    </div>

                                    <p>

                                        "<%= review.comment %>"

                                    </p>

                                    <div class="testimonial-user">

                                        <div class="review-avatar">

                                            <img
                                                src="<%= getProfileImage(review) %>"
                                                alt="<%= review.full_name %>"
                                            >

                                        </div>

                                        <div>

                                            <strong>

                                                <%= review.full_name %>

                                            </strong>

                                            <small>

                                                Verified L-Ease Member

                                            </small>

                                        </div>

                                    </div>

                                </div>

                            <% }) %>

                        </div>

                    <% } %>

                </section>

                <!-- CALL TO ACTION -->

                    <section class="homepage-cta">

                        <div class="cta-content">

                            <h2>

                                Ready to Start Leasing?

                            </h2>

                            <p>

                                Join thousands of owners and renters using L-Ease to lease assets
                                safely and conveniently.

                            </p>

                            <div class="cta-buttons">

                                <a href="/listings" class="primary-btn">

                                    Browse Assets

                                </a>

                                <% if(user){ %>

                                    <a href="/listings/new" class="secondary-btn">

                                        List an Asset

                                    </a>

                                <% } else { %>

                                    <a href="/register" class="secondary-btn">

                                        Join Today

                                    </a>

                                <% } %>

                            </div>

                        </div>

                    </section>

    </main>

    <%- include("partials/footer") %>

    <%- include("partials/scripts") %>

</body>

</html>