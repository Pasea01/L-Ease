<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

    <header>
        <%- include("partials/navbar") %>
    </header>

    <main>

        <!-- HERO -->
        <section class="hero">

            <div class="hero-content">

                <h1>Lease Anything, Anytime.</h1>

                <p>
                    Find trusted rentals for property, vehicles,
                    electronics, furniture, tools, equipment and much more.
                </p>

                <form action="/listings" method="GET" class="hero-search">

                    <input
                        type="text"
                        name="search"
                        placeholder="What are you looking for?"
                    >

                    <select name="category">

                        <option value="">All Categories</option>
                        <option>Property</option>
                        <option>Vehicles</option>
                        <option>Electronics</option>
                        <option>Furniture</option>
                        <option>Tools</option>
                        <option>Equipment</option>
                        <option>Livestock</option>

                    </select>

                    <button type="submit">
                        Search
                    </button>

                </form>

            </div>

        </section>


        <!-- MARKET SECTION -->

        <section class="market-home">

            <aside class="category-sidebar">

                <h3>Browse Categories</h3>

                <a href="/listings?category=Property">
                    <img src="/images/categories/property.png">
                    <span>Property</span>
                </a>

                <a href="/listings?category=Vehicle">
                    <img src="/images/categories/vehicle.png">
                    <span>Vehicles</span>
                </a>

                <a href="/listings?category=Electronics">
                    <img src="/images/categories/electronics.png">
                    <span>Electronics</span>
                </a>

                <a href="/listings?category=Furniture">
                    <img src="/images/categories/furniture.png">
                    <span>Furniture</span>
                </a>

                <a href="/listings?category=Tools">
                    <img src="/images/categories/tools.png">
                    <span>Tools</span>
                </a>

                <a href="/listings?category=Equipment">
                    <img src="/images/categories/equipment.png">
                    <span>Equipment</span>
                </a>

                <a href="/listings?category=Livestock">
                    <img src="/images/categories/livestock.png">
                    <span>Livestock</span>
                </a>

                <a href="/listings?category=Other">
                    <img src="/images/categories/others.png">
                    <span>Other</span>
                </a>

            </aside>


            <div class="market-content">

                <div class="section-header">

                    <h2>Featured Assets</h2>

                    <a href="/listings">
                        View All →
                    </a>

                </div>

                <div class="listing-grid">

                    <% listings.forEach(listing => { %>

                        <a href="/listings/<%= listing.id %>" class="listing-card">

                            <% if(listing.image_url){ %>

                                <img
                                    src="/uploads/<%= listing.image_url %>"
                                    class="listing-image"
                                >

                            <% } else { %>

                                <img
                                    src="<%= getCategoryImage(listing.category) %>"
                                    class="listing-image"
                                >

                            <% } %>

                            <div class="listing-content">

                                <h3><%= listing.title %></h3>

                                <p>📍 <%= listing.location %></p>

                                <p>👤 <%= listing.full_name %></p>

                                <div class="listing-price">

                                    KES <%= Number(listing.price_per_day).toLocaleString() %>

                                    <span>/ day</span>

                                </div>

                            </div>

                        </a>

                    <% }) %>

                </div>

            </div>

        </section>


        <!-- HOW IT WORKS -->

        <section class="how-it-works">

            <h2>How L-Ease Works</h2>

            <div class="steps">

                <div class="step">

                    <span>1</span>

                    <h3>List an Asset</h3>

                    <p>Create a listing in minutes.</p>

                </div>

                <div class="step">

                    <span>2</span>

                    <h3>Receive Requests</h3>

                    <p>Interested users contact you directly.</p>

                </div>

                <div class="step">

                    <span>3</span>

                    <h3>Earn Money</h3>

                    <p>Lease your assets securely.</p>

                </div>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

    <%- include("partials/scripts") %>

</body>

</html>