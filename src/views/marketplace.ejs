<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

    <%- include("partials/navbar") %>

    <main class="marketplace-page">

        <section class="page-header">
            <div>
                <h1>Browse Assets</h1>
                <p>Discover quality assets available for lease from trusted owners.</p>
            </div>
        </section>

        <section class="marketplace-layout">

            <!-- FILTERS -->
            <aside class="filters-card">
                <h3>Filters</h3>

                <form action="/listings" method="GET">

                    <div class="filter-group">
                        <label>Search</label>
                        <input
                            type="text"
                            name="search"
                            placeholder="Search assets..."
                            value="<%= search || '' %>"
                        >
                    </div>

                    <div class="filter-group">
                        <label>Category</label>
                        <select name="category">
                            <option value="">All Categories</option>
                            <option value="Property" <%= category === "Property" ? "selected" : "" %>>Property</option>
                            <option value="Vehicle" <%= category === "Vehicle" ? "selected" : "" %>>Vehicle</option>
                            <option value="Electronics" <%= category === "Electronics" ? "selected" : "" %>>Electronics</option>
                            <option value="Furniture" <%= category === "Furniture" ? "selected" : "" %>>Furniture</option>
                            <option value="Tools" <%= category === "Tools" ? "selected" : "" %>>Tools</option>
                            <option value="Equipment" <%= category === "Equipment" ? "selected" : "" %>>Equipment</option>
                            <option value="Livestock" <%= category === "Livestock" ? "selected" : "" %>>Livestock</option>
                            <option value="Other" <%= category === "Other" ? "selected" : "" %>>Other</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>Location</label>
                        <input
                            type="text"
                            name="location"
                            placeholder="Location"
                            value="<%= location || '' %>"
                        >
                    </div>

                    <div class="filter-group">
                        <label>Minimum Price</label>
                        <input
                            type="number"
                            name="minPrice"
                            value="<%= minPrice || '' %>"
                        >
                    </div>

                    <div class="filter-group">
                        <label>Maximum Price</label>
                        <input
                            type="number"
                            name="maxPrice"
                            value="<%= maxPrice || '' %>"
                        >
                    </div>

                    <div class="filter-group">
                        <label>Sort By</label>
                        <select name="sort">
                            <option value="newest" <%= sort === "newest" ? "selected" : "" %>>Newest</option>
                            <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>Oldest</option>
                            <option value="price-low" <%= sort === "price-low" ? "selected" : "" %>>Lowest Price</option>
                            <option value="price-high" <%= sort === "price-high" ? "selected" : "" %>>Highest Price</option>
                        </select>
                    </div>

                    <button class="primary-btn" type="submit">
                        Apply Filters
                    </button>

                </form>
            </aside>

            <!-- LISTINGS -->
            <section class="marketplace-results">

                <div class="results-header">
                    <h2>Available Assets</h2>
                    <span><%= listings.length %> results</span>
                </div>

                <% if (listings.length === 0) { %>

                    <div class="empty-state">
                        <h3>No assets found.</h3>
                        <p>Try changing your filters or search terms.</p>
                    </div>

                <% } else { %>

                    <div class="listing-grid">

                        <% listings.forEach(listing => { %>

                            <a href="/listings/<%= listing.id %>" class="listing-card">

                                <img
                                    src="<%= getListingImage(listing) %>"
                                    class="listing-image"
                                    alt="<%= listing.title %>"
                                    onerror="this.onerror=null; this.src='<%= getCategoryImage(listing.category) %>';"
                                >

                                <div class="listing-content">

                                    <h3><%= listing.title %></h3>

                                    <p>📍 <%= listing.location %></p>

                                    <p>👤 <%= listing.full_name %></p>

                                    <div class="listing-rating">

                                        <% if (listing.review_count > 0) { %>

                                            <span class="rating-star">⭐</span>

                                            <span class="rating-score">
                                                <%= listing.average_rating %>
                                            </span>

                                            <span class="rating-count">
                                                (<%= listing.review_count %>)
                                            </span>

                                        <% } else { %>

                                            <span class="rating-none">
                                                New Listing
                                            </span>

                                        <% } %>

                                    </div>

                                    <div class="listing-price">
                                        KES <%= Number(listing.price_per_day).toLocaleString() %>
                                        <span>/ day</span>
                                    </div>

                                </div>

                            </a>

                        <% }) %>

                    </div>

                <% } %>

            </section>

        </section>

    </main>

    <%- include("partials/footer") %>

    <%- include("partials/scripts") %>
</body>
</html>