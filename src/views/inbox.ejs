<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="inbox-page">

    <section class="inbox-wrapper">

        <!-- LEFT SIDEBAR -->

        <aside class="inbox-sidebar">

            <div class="inbox-sidebar-header">

                <h1>Messages</h1>

                <input
                    type="text"
                    placeholder="Search conversations..."
                    class="conversation-search"
                >

            </div>

            <% if(conversations.length===0){ %>

                <div class="empty-sidebar">

                    <p>No conversations yet.</p>

                </div>

            <% }else{ %>

                <div class="conversation-list">

                    <% conversations.forEach(conversation=>{ %>

                    <a
                        href="/messages/<%= conversation.asset_id %>/<%= conversation.other_user_id %>"
                        class="conversation-item"
                    >

                        <div class="conversation-avatar">

                            <%= conversation.other_user.charAt(0).toUpperCase() %>

                        </div>

                        <div class="conversation-info">

                            <div class="conversation-top">

                                <h3>

                                    <%= conversation.other_user %>

                                </h3>

                                <small>

                                    <%= conversation.last_time %>

                                </small>

                            </div>

                            <p class="conversation-asset">

                                <%= conversation.title %>

                            </p>

                            <p class="conversation-preview">

                                <%= conversation.last_message %>

                            </p>

                        </div>

                    </a>

                    <% }) %>

                </div>

            <% } %>

        </aside>

        <!-- RIGHT PANEL -->

        <section class="inbox-placeholder">

            <div class="placeholder-content">

                <div class="placeholder-icon">

                    💬

                </div>

                <h2>

                    Select a conversation

                </h2>

                <p>

                    Choose a conversation from the left to start messaging.

                </p>

            </div>

        </section>

    </section>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>