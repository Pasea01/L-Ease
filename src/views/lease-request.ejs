<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="lease-page">

    <section class="create-header">

        <div>

            <h1>Request Lease</h1>

            <p>

                Review the listing and send your lease request.

            </p>

        </div>

    </section>

    <form
        action="/leases/request"
        method="POST"
        class="lease-layout"
    >

        <input
            type="hidden"
            name="asset_id"
            value="<%= listing.id %>"
        >

        <!-- LEFT -->

        <section class="lease-details">

            <div class="form-card">

                <% if(listing.image_url){ %>

                    <img
                        src="<%= getListingImage(listing) %>"
                        class="lease-image"
                        alt="<%= listing.title %>"
                        onerror="this.onerror=null; this.src='<%= getCategoryImage(listing.category) %>';"
                    >

                <% } else { %>

                    <img
                        src="<%= getCategoryImage(listing.category) %>"
                        class="lease-image"
                        alt="<%= listing.category %>"
                    >

                <% } %>

                <div class="lease-info">

                    <h2><%= listing.title %></h2>

                    <p>📍 <%= listing.location %></p>

                    <p><strong>Category:</strong> <%= listing.category %></p>

                    <p><strong>Owner:</strong> <%= listing.full_name %></p>

                    <p class="lease-price">

                        KES <%= listing.price_per_day %> / day

                    </p>

                </div>

            </div>

        </section>

        <!-- RIGHT -->

        <aside class="lease-sidebar">

            <div class="form-card">

                <h2>Booking Details</h2>

                <div class="form-group">

                    <label>Start Date</label>

                    <input
                        type="date"
                        name="start_date"
                        min="<%= new Date().toISOString().slice(0, 10) %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>End Date</label>

                    <input
                        type="date"
                        name="end_date"
                        min="<%= new Date().toISOString().slice(0, 10) %>"
                        id="lease-end-date"
                        required
                    >

                </div>

                <div class="form-group">

                    <label>Message to Owner</label>

                    <textarea
                        name="message"
                        rows="6"
                        maxlength="1000"
                        placeholder="Introduce yourself or explain your intended use..."
                    ></textarea>

                </div>

                <hr>

                <div class="price-summary">

                    <div>

                        <span>Daily Rate</span>

                        <strong>KES <%= listing.price_per_day %></strong>

                    </div>

                    <div>

                        <span>Lease Duration</span>

                        <strong>Calculated later</strong>

                    </div>

                    <div>

                        <span>Total</span>

                        <strong>Calculated after approval</strong>

                    </div>

                </div>

                <button
                    type="submit"
                    class="publish-btn"
                >

                    Request Lease

                </button>

            </div>

        </aside>

    </form>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

<script>
    const leaseStartDate = document.querySelector('[name="start_date"]');
    const leaseEndDate = document.getElementById("lease-end-date");

    leaseStartDate.addEventListener("change", () => {
        leaseEndDate.min = leaseStartDate.value || leaseEndDate.min;
        if (leaseEndDate.value && leaseEndDate.value < leaseEndDate.min) {
            leaseEndDate.value = leaseEndDate.min;
        }
    });
</script>

</body>

</html>