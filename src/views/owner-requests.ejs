<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="lease-owner-page">

    <section class="create-header">

        <div>

            <h1>Lease Requests</h1>

            <p>

                Review incoming lease requests for your listings.

            </p>

        </div>

    </section>

    <% if(requests.length===0){ %>

    <section class="empty-state-card">

        <div class="empty-icon">📋</div>

        <h2>No Requests Yet</h2>

        <p>

            Lease requests will appear here when someone requests one of your listings.

        </p>

    </section>

    <% } else { %>

    <section class="request-grid">

        <% requests.forEach(request=>{ %>

        <article class="request-card">

            <div class="request-top">

                <div>

                    <h2><%= request.title %></h2>

                    <p>

                        Requested by <strong><%= request.tenant_name %></strong>

                    </p>

                </div>

                <span class="status-badge status-<%= request.status %>">

                    <%= request.status %>

                </span>

            </div>

            <div class="request-details">

                <div>

                    <span>📅 Start</span>

                    <strong><%= request.start_date %></strong>

                </div>

                <div>

                    <span>📅 End</span>

                    <strong><%= request.end_date %></strong>

                </div>

            </div>

            <div class="request-message">

                <h4>Message</h4>

                <p>

                    <%= request.message || "No message provided." %>

                </p>

            </div>

            <% if(request.status==="pending"){ %>

                <div class="request-actions">

                    <form
                        action="/leases/<%= request.id %>/approve"
                        method="POST"
                    >

                        <button class="approve-btn">

                            ✓ Approve

                        </button>

                    </form>

                    <form
                        action="/leases/<%= request.id %>/reject"
                        method="POST"
                    >

                        <button class="reject-btn">

                            ✕ Reject

                        </button>

                    </form>

                </div>

                <% } else if(request.status==="approved" && !request.completed){ %>

                <div class="request-actions">

                    <form
                        action="/leases/<%= request.id %>/complete"
                        method="POST"
                    >

                        <button class="primary-btn">

                            ✔ Mark Lease Complete

                        </button>

                    </form>

                </div>

                <% } else if(request.completed){ %>

                <div class="request-actions">

                    <span class="success-badge">

                        ✔ Lease Completed

                    </span>

                </div>

                <% } %>

        </article>

        <% }) %>

    </section>

    <% } %>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>