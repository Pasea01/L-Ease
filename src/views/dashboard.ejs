<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="dashboard-page">

    <div class="dashboard-layout">

        <!-- Sidebar -->

        <aside class="dashboard-sidebar">

            <div class="sidebar-profile">

                <div class="sidebar-avatar">

                    <%= user.full_name.charAt(0).toUpperCase() %>

                </div>

                <h3><%= user.full_name %></h3>

                <p>Marketplace Member</p>

            </div>

            <nav class="dashboard-menu">

                <a href="/dashboard" class="active">🏠 Dashboard</a>

                <a href="/profile">👤 Profile</a>

                <a href="/listings/my-listings">📦 My Listings</a>

                <a href="/leases/owner">📋 Lease Requests</a>

                <a href="/inbox">💬 Messages</a>

                <a href="#">⭐ Reviews</a>

                <a href="#">⚙ Settings</a>

            </nav>

        </aside>

        <!-- Main -->

        <section class="dashboard-main">

            <div class="dashboard-hero">

                <div>

                    <h1>Welcome back, <%= user.full_name %> 👋</h1>

                    <p>Manage everything from one place.</p>

                </div>

                <a href="/listings/new" class="primary-btn">

                    + New Listing

                </a>

            </div>

            <div class="dashboard-stats">

                <div class="dashboard-stat">

                    <div class="stat-icon">📦</div>

                    <h2>0</h2>

                    <p>Listings</p>

                </div>

                <div class="dashboard-stat">

                    <div class="stat-icon">📑</div>

                    <h2>0</h2>

                    <p>Requests</p>

                </div>

                <div class="dashboard-stat">

                    <div class="stat-icon">💬</div>

                    <h2>0</h2>

                    <p>Messages</p>

                </div>

                <div class="dashboard-stat">

                    <div class="stat-icon">⭐</div>

                    <h2>0</h2>

                    <p>Reviews</p>

                </div>

            </div>

            <div class="dashboard-card">

                <h2>Recent Activity</h2>

                <div class="empty-state">

                    <h3>No recent activity</h3>

                    <p>Your latest listings and lease activity will appear here.</p>

                </div>

            </div>

        </section>

    </div>

    

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>