<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="profile-page">

    <div class="profile-layout">

        <!-- Sidebar -->

        <aside class="profile-sidebar">

            <h1>Profile</h1>

            <nav class="profile-menu">

                <a href="/profile" class="active">
                    👤 About Me
                </a>

                <a href="/dashboard">
                    📊 Dashboard
                </a>

                <a href="/listings/my-listings">
                    📦 My Listings
                </a>

                <a href="/leases/owner">
                    📋 Lease Requests
                </a>

                <a href="/inbox">
                    💬 Messages
                </a>

            </nav>

        </aside>

        <!-- Main -->

        <section class="profile-content">

            <div class="profile-header">

                <h1>About Me</h1>

                <a href="/profile/edit" class="secondary-btn">

                    Edit

                </a>

            </div>

            <!-- Profile Card -->

            <div class="profile-card">

                <div class="profile-avatar">

                    <% if(user.profile_image && user.profile_image !== "default.png"){ %>

                        <img
                            src="/uploads/profiles/<%= user.profile_image %>"
                            alt="<%= user.full_name %>"
                        >

                    <% } else { %>

                        <span>

                            <%= user.full_name.charAt(0).toUpperCase() %>

                        </span>

                    <% } %>

                </div>

                <h2><%= user.full_name %></h2>

                <p class="profile-role">

                    Member

                </p>

                <div class="profile-rating">

                    <% if (rating && rating.total > 0) { %>

                        <div class="rating-stars">

                            <% const fullStars = Math.round(rating.average); %>

                            <% for(let i=1;i<=5;i++){ %>

                                <% if(i<=fullStars){ %>

                                    ⭐

                                <% }else{ %>

                                    ☆

                                <% } %>

                            <% } %>

                        </div>

                        <div class="rating-info">

                            <strong>

                                <%= rating.average %>

                            </strong>

                            <span>

                                Based on
                                <%= rating.total %>
                                review<%= rating.total>1?"s":"" %>

                            </span>

                        </div>

                    <% } else { %>

                        <span class="rating-none">

                            No reviews yet

                        </span>

                    <% } %>

                </div>

            </div>

            <!-- Personal Information -->

            <div class="profile-section">

                <h2>Personal Information</h2>

                <div class="profile-info">

                    <div class="profile-item">

                        <span>Email</span>

                        <strong>

                            <%= user.email %>

                        </strong>

                    </div>

                    <div class="profile-item">

                        <span>Phone</span>

                        <strong>

                            <%= user.phone || "Not provided" %>

                        </strong>

                    </div>

                    <div class="profile-item">

                        <span>Member Since</span>

                        <strong>

                            <%= new Date(user.created_at).toLocaleDateString() %>

                        </strong>

                    </div>

                </div>

            </div>

            <!-- About -->

            <div class="profile-section">

                <h2>About</h2>

                <p class="profile-bio">

                    <%= user.bio || "Tell other members a little about yourself. This helps build trust with owners and renters." %>

                </p>

            </div>

            <!-- Statistics -->

            <div class="profile-section">

                <h2>Statistics</h2>

                <div class="activity-grid">

                    <div class="activity-box">

                        <h1>

                            <%= stats.listings %>

                        </h1>

                        <p>Listings</p>

                    </div>

                    <div class="activity-box">

                        <h1>

                            <%= stats.lease_requests %>

                        </h1>

                        <p>Pending Requests</p>

                    </div>

                    <div class="activity-box">

                        <h1>

                            <%= stats.successful_leases %>

                        </h1>

                        <p>Completed Leases</p>

                    </div>

                    <div class="activity-box">

                        <h1>

                            <%= rating ? rating.total : 0 %>

                        </h1>

                        <p>Reviews</p>

                    </div>

                </div>

            </div>

            <!-- Recent Reviews -->

            <div class="profile-section">

                <div class="section-header">

                    <h2>

                        Recent Reviews

                    </h2>

                    <a href="/profile/reviews" class="view-all-link">

                        View All →

                    </a>

                </div>

                <% if(reviews.length === 0){ %>

                    <div class="empty-state">

                        <h3>

                            No reviews yet

                        </h3>

                        <p>

                            Complete your first lease to receive your first review.

                        </p>

                    </div>

                <% } else { %>

                    <div class="review-list">

                        <% reviews.slice(0,2).forEach(review => { %>

                            <div class="review-card">

                                <div class="review-header">

                                    <div class="review-user">

                                        <div class="review-avatar">

                                            <img
                                                src="<%= getProfileImage(review) %>"
                                                alt="<%= review.full_name %>"
                                            >

                                        </div>

                                        <div>

                                            <strong>

                                                <%= review.full_name %>

                                            </strong>

                                            <small>

                                                <%= new Date(review.created_at).toLocaleDateString() %>

                                            </small>

                                        </div>

                                    </div>

                                    <div class="review-stars">

                                        <% for(let i=1;i<=5;i++){ %>

                                            <% if(i<=review.rating){ %>

                                                ⭐

                                            <% }else{ %>

                                                ☆

                                            <% } %>

                                        <% } %>

                                    </div>

                                </div>

                                <p class="review-comment">

                                    <%= review.comment %>

                                </p>

                            </div>

                        <% }) %>

                    </div>

                    <% if(reviews.length > 2){ %>

                        <div class="profile-review-footer">

                            <a href="/profile/reviews" class="secondary-btn">

                                View All <%= reviews.length %> Reviews

                            </a>

                        </div>

                    <% } %>

                <% } %>

            </div>

        </section>

    </div>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>