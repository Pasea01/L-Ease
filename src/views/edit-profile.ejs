<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="create-listing-page">

    <section class="create-header">

        <div>

            <h1>Edit Profile</h1>

            <p>

                Keep your personal information up to date.

            </p>

        </div>

    </section>

    <form
        action="/profile/edit"
        method="POST"
        enctype="multipart/form-data"
        class="listing-form"
    >

        <div class="listing-layout">

            <!-- Left -->

            <div class="listing-main">

                <div class="form-card">

                    <h2>Personal Information</h2>

                    <div class="form-group">

                        <label for="profile-name">Full Name</label>

                        <input
                            type="text"
                            name="full_name"
                            id="profile-name"
                            value="<%= user.full_name %>"
                            minlength="2"
                            maxlength="80"
                            autocomplete="name"
                            required
                        >

                    </div>

                    <div class="form-group">

                        <label for="profile-email">Email Address</label>

                        <input
                            type="email"
                            name="email"
                            id="profile-email"
                            value="<%= user.email %>"
                            maxlength="254"
                            autocomplete="email"
                            required
                        >

                    </div>

                    <div class="form-group">

                        <label for="profile-phone">Phone Number</label>

                        <input
                            type="text"
                            name="phone"
                            id="profile-phone"
                            value="<%= user.phone || '' %>"
                            minlength="7"
                            maxlength="20"
                            autocomplete="tel"
                            placeholder="+254..."
                        >

                    </div>

                </div>

            </div>

            <!-- Right -->

            <aside class="listing-sidebar">

                <div class="form-card profile-summary">

                     <input
                        type="file"
                        id="profile_image"
                        name="profile_image"
                        accept="image/*"
                        hidden
                    >

                    <label
                        for="profile_image"
                        class="profile-avatar-upload"
                    >

                        <% if (user.profile_image && user.profile_image !== "default.png") { %>

                            <img
                                src="<%= getProfileImage(user.profile_image) %>"
                                class="profile-avatar-large"
                                id="profilePreview"
                            >

                        <% } else { %>

                            <div
                                class="profile-avatar-large avatar-placeholder"
                                id="profilePreviewLetter"
                            >
                                <%= user.full_name.charAt(0).toUpperCase() %>
                            </div>

                        <% } %>

                        <span class="avatar-edit-btn">
                            <i class="fa-solid fa-camera"></i>
                        </span>

                    </label>

                    <h2><%= user.full_name %></h2>

                    <p class="profile-role">

                        <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>

                    </p>

                </div>

                <div class="form-card">

                    <button
                        type="submit"
                        class="publish-btn"
                    >

                        Save Changes

                    </button>

                    <a
                        href="/profile"
                        class="cancel-btn"
                    >

                        Cancel

                    </a>

                </div>

            </aside>

        </div>

    </form>

</main>

        <script>
            const input = document.getElementById("profile_image");

            input.addEventListener("change", function () {

                const file = this.files[0];

                if (!file) return;

                const preview = document.querySelector(".profile-avatar-large");

                const img = document.createElement("img");

                img.src = URL.createObjectURL(file);
                img.className = "profile-avatar-large";
                img.id = "profilePreview";

                preview.replaceWith(img);

            });
            </script>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>