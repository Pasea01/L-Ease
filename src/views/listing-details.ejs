<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="details-page">

    <div class="details-grid">

        <!-- LEFT -->

        <section class="details-main">

            <% if (listing.image_url) { %>

                <img
                    src="/uploads/<%= listing.image_url %>"
                    class="details-image"
                    alt="<%= listing.title %>"
                >

            <% } else { %>

                <img
                    src="<%= getCategoryImage(listing.category) %>"
                    class="details-image"
                    alt="<%= listing.category %>"
                >

            <% } %>

            <div class="details-card">

                <span class="asset-category">

                    <%= listing.category %>

                </span>

                <h1>

                    <%= listing.title %>

                </h1>

                <p class="asset-location">

                    📍 <%= listing.location %>

                </p>

                <div class="asset-meta">

                    <div>

                        <small>Owner</small>

                        <strong><%= listing.full_name %></strong>

                    </div>

                    <div>

                        <small>Daily Rate</small>

                        <strong>KES <%= Number(listing.price_per_day).toLocaleString() %></strong>

                    </div>

                </div>

            </div>

            <div class="details-card">

                <h2>Description</h2>

                <p>

                    <%= listing.description %>

                </p>

            </div>

        </section>

        <!-- RIGHT -->

        <aside class="booking-card">

            <h2>

                KES <%= Number(listing.price_per_day).toLocaleString() %>

                <span>/day</span>

            </h2>

            <p>

                Secure your lease request directly from the owner.

            </p>

            <% if (user) { %>

                <% if(user.id !== listing.owner_id){ %>

                    <a
                        href="/leases/request/<%= listing.id %>"
                        class="primary-btn full-btn"
                    >

                        Request Lease

                    </a>

                <% } else { %>

                    <button
                        class="secondary-btn full-btn"
                        disabled
                    >

                        Your Listing

                    </button>

                <% } %>

            <% } else { %>

                <a
                    href="/login"
                    class="primary-btn full-btn"
                >

                    Login to Request

                </a>

            <% } %>

            <hr>

                <div class="owner-card">

                    <h3>Owner</h3>

                    <strong><%= listing.full_name %></strong>

                    <p>Verified L-Ease member</p>

                </div>

                <div class="booking-footnote">

                    Your request is sent directly to the owner. No payment is required until the lease is approved.

                </div>

        </aside>


    </div>


</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>