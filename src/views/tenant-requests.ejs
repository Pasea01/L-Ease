<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="lease-owner-page">

    <section class="create-header">

        <div>

            <h1>My Lease Requests</h1>

            <p>

                Track the status of every lease request you've submitted.

            </p>

        </div>

    </section>

    <% if(requests.length===0){ %>

    <section class="empty-state-card">

        <div class="empty-icon">📨</div>

        <h2>No Requests Yet</h2>

        <p>

            Browse listings and request your first lease.

        </p>

        <a
            href="/listings"
            class="primary-btn"
        >

            Browse Listings

        </a>

    </section>

    <% } else { %>

    <section class="request-grid">

        <% requests.forEach(request=>{ %>

        <article class="request-card">

            <div class="request-layout">

                <div class="request-image">

                    <img
                        src="<%= getListingImage(request) %>"
                        alt="<%= request.title %>"
                        onerror="this.onerror=null; this.src='<%= getCategoryImage(request.category) %>';"
                    >

                </div>

                <div class="request-content">

                    <div class="request-top">

                        <div>

                            <h2><%= request.title %></h2>

                            <p>

                                Host: <strong><%= request.owner_name %></strong>

                            </p>

                        </div>

                        <span class="status-badge status-<%= request.status === 'cancelled' ? 'rejected' : request.status %>">
                            <%= request.status === "cancelled" ? "Rejected" : request.status %>
                        </span>

                    </div>

                    <div class="request-details">

                        <div>

                            <span>📅 Start</span>

                            <strong><%= request.start_date %></strong>

                        </div>

                        <div>

                            <span>📅 End</span>

                            <strong><%= request.end_date %></strong>

                        </div>

                    </div>

                    <div class="request-actions">

                        <% if(request.status === "completed"){ %>

                            <% if(!request.has_reviewed){ %>
                                <a
                                    href="/reviews/new/<%= request.id %>"
                                    class="primary-btn"
                                >
                                    ⭐ Leave Review
                                </a>
                            <% } else { %>
                                <span class="success-badge">✔ Review Submitted</span>
                            <% } %>

                        <% } else if(request.status === "approved" || request.status === "active"){ %>

                            <a
                                href="/messages/<%= request.asset_id %>/<%= request.owner_id %>"
                                class="primary-btn"
                            >

                                Open Chat

                            </a>

                        <% } else if(request.status === "pending"){ %>

                            <button
                                class="secondary-btn"
                                type="button"
                                disabled
                            >

                                Awaiting Approval

                            </button>

                        <% } else { %>

                            <button
                                class="danger-btn"
                                type="button"
                                disabled
                            >

                                Rejected

                            </button>

                        <% } %>

                    </div>

                </div>

            </div>

        </article>

        <% }) %>

    </section>

    <% } %>

</main>

<%- include("partials/footer") %>


<%- include("partials/scripts") %>

</body>

</html>