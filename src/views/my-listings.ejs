<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/navbar") %>

<main class="my-listings-page">

    <section class="page-header">

        <div>

            <h1>My Listings</h1>

            <p>Manage the assets you've listed on L-Ease.</p>

        </div>

        <a href="/listings/new" class="primary-btn">

            + New Listing

        </a>

    </section>

    <% if(listings.length === 0){ %>

    <section class="empty-state-card">

        <div class="empty-icon">📦</div>

        <h2>No Listings Yet</h2>

        <p>

            Start earning by listing your first asset.

        </p>

        <a href="/listings/new" class="primary-btn">

            Create Listing

        </a>

    </section>

    <% } else { %>

    <section class="host-grid">

        <% listings.forEach(listing=>{ %>

        <article class="host-card">

            <div class="image-wrapper">

                <a href="/listings/<%= listing.id %>">

                    
                    <img
                        src="<%= getListingImage(listing) %>"
                        alt="<%= listing.title %>"
                        class="host-image"
                        onerror="this.onerror=null; this.src='<%= getCategoryImage(listing.category) %>';"
                    >

                </a>

                <details class="card-menu">

                    <summary>⋮</summary>

                    <div class="menu-dropdown">

                        <a href="/listings/<%= listing.id %>">

                            👁 View

                        </a>

                        <a href="/listings/edit/<%= listing.id %>">

                            ✏ Edit

                        </a>

                        <form
                            action="/listings/delete/<%= listing.id %>"
                            method="POST"
                            onsubmit="return confirm('Delete this listing?')"
                        >
                            <button type="submit" class="menu-dropdown-action">
                                🗑 Delete
                            </button>
                        </form>

                    </div>

                </details>

            </div>

            <a
                href="/listings/<%= listing.id %>"
                class="card-link"
            >

                <div class="host-content">

                    <div class="host-title-row">

                        <h3>

                            <%= listing.title %>

                        </h3>

                        <span class="host-price">

                            KES <%= Number(listing.price_per_day).toLocaleString() %>/day

                        </span>

                    </div>

                    <div class="listing-rating">

                        <% if (listing.review_count > 0) { %>

                            <span class="rating-star">⭐</span>

                            <span class="rating-score">

                                <%= listing.average_rating %>

                            </span>

                            <span class="rating-count">

                                (<%= listing.review_count %> Reviews)

                            </span>

                        <% } else { %>

                            <span class="rating-none">

                                No reviews yet

                            </span>

                        <% } %>

                    </div>

                    <div class="host-metrics">

                        <div class="metric">

                            📑

                            <strong>

                                <%= listing.pending_requests %>

                            </strong>

                            Pending

                        </div>

                        <div class="metric">

                            ✔

                            <strong>

                                <%= listing.completed_leases %>

                            </strong>

                            Completed

                        </div>

                    </div>

                    <p class="host-location">

                        📍 <%= listing.location %>

                    </p>

                    <span class="host-category">

                        <%= listing.category %>

                    </span>

                    <p class="host-description">

                        <%= listing.description.length > 80
                            ? listing.description.substring(0,80) + "..."
                            : listing.description %>

                    </p>

                </div>

            </a>

        </article>

        <% }) %>

    </section>

    <% } %>

</main>

<%- include("partials/footer") %>

<%- include("partials/scripts") %>

</body>

</html>