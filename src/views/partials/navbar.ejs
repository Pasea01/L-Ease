<% if (flash) { %>
<div class="flash flash-<%= flash.type %>">
    <%= flash.message %>
</div>
<% } %>

<nav class="navbar">

    <!-- Left -->

    <div class="navbar-left">

        <a href="/" class="logo" aria-label="L-Ease home">
            <svg
                class="logo-image"
                viewBox="0 0 909 391"
                role="img"
                aria-labelledby="logo-title"
            >
                <title id="logo-title">L-Ease — Lease. Easy. Smart.</title>
                <defs>
                    <linearGradient id="logo-blue" x1="20" y1="30" x2="340" y2="360" gradientUnits="userSpaceOnUse">
                        <stop stop-color="var(--primary)" />
                        <stop offset="1" stop-color="var(--primary-dark)" />
                    </linearGradient>
                </defs>
                <path
                    d="M312 220V118Q312 107 301 101L178 37Q165 30 152 37L35 102Q22 109 22 123V254Q22 268 35 276L153 345Q166 353 179 346L248 306"
                    fill="none"
                    stroke="url(#logo-blue)"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="27"
                />
                <circle
                    cx="291"
                    cy="285"
                    r="33"
                    fill="none"
                    stroke="url(#logo-blue)"
                    stroke-width="24"
                />
                <path
                    d="M139 127V252Q139 270 157 270H211Q229 270 229 254Q229 238 212 238H172V127Q172 111 155 111Q139 111 139 127Z"
                    fill="url(#logo-blue)"
                />
                <path
                    d="M237 338L253 329L260 341L244 350Z"
                    fill="url(#logo-blue)"
                    stroke="url(#logo-blue)"
                    stroke-linejoin="round"
                    stroke-width="5"
                />
                <text
                    x="384"
                    y="221"
                    fill="var(--text)"
                    font-family="Arial, Helvetica, sans-serif"
                    font-size="165"
                    font-weight="700"
                    letter-spacing="-6"
                >L-Ease</text>
                <text
                    x="386"
                    y="301"
                    fill="var(--text)"
                    font-family="Arial, Helvetica, sans-serif"
                    font-size="49"
                    font-weight="400"
                    letter-spacing="0.5"
                >Lease. Easy. Smart.</text>
            </svg>
        </a>

    </div>

    <!-- Center -->

    <div class="navbar-center">

        <ul class="nav-links">

            <li>

                <a href="/listings">

                    Browse Assets

                </a>

            </li>

            <li>
                <a href="/about">About</a>
            </li>

        </ul>

    </div>

    <!-- Right -->

    <div class="navbar-right">
        <!-- Theme Toggle -->
            <button
                type="button"
                class="theme-toggle"
                id="themeToggle"
                aria-label="Switch to dark mode"
                title="Switch theme"
            >
                🌙
            </button>

        <% if(user){ %>

        <div class="navbar-actions">

            <!-- Notifications -->

            <div class="notification-menu">

                <button

                    class="notification-btn"

                    id="notificationBtn"

                >

                    🔔

                    <% if(unreadNotifications > 0){ %>

                        <span class="notification-count">

                            <%= unreadNotifications %>

                        </span>

                    <% } %>

                </button>

                <div
                    class="notification-dropdown"
                    id="notificationDropdown"
                >

                    <div class="notification-header">

                        <strong>

                            Notifications

                        </strong>

                        <% if(unreadNotifications > 0){ %>

                            <form
                                action="/notifications/mark-all-read"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="mark-read-btn"
                                >

                                    ✓ Mark all as read

                                </button>

                            </form>

                        <% } %>

                    </div>

                    <hr>

                    <% if(notifications.length === 0){ %>

                        <div class="notification-empty">

                            No notifications yet.

                        </div>

                    <% } else { %>

                        <% notifications.forEach(notification => { %>

                            <a

                                href="/notifications/<%= notification.id %>"

                                class="notification-item <%= notification.is_read ? '' : 'unread' %>"

                            >

                                <strong>

                                    <%= notification.title %>

                                </strong>

                                <small>

                                    <%= notification.message %>

                                </small>

                            </a>

                        <% }) %>

                    <% } %>

                </div>

            </div>

            <!-- User Menu -->

            <div class="user-menu">

                <button

                    class="user-btn"

                    id="userMenuBtn"

                >

                    
                    <div class="avatar">
                        <% const profileImage = getProfileImage(user.profile_image); %>

                        <% if (profileImage) { %>
                            <img
                                src="<%= profileImage %>"
                                alt="<%= user.full_name %>"
                                class="avatar-image"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                            >
                        <% } %>

                        <span
                            class="avatar-initial"
                            style="<%= profileImage ? 'display:none;' : 'display:flex;' %>"
                        >
                            <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : '?' %>
                        </span>
                    </div>

                </button>

                <div

                    class="dropdown-menu"

                    id="dropdownMenu"

                >

                    <div class="dropdown-header">

                        <strong>

                            <%= user.full_name %>

                        </strong>

                        <small>

                            <%= user.email %>

                        </small>

                    </div>

                    <hr>

                    <a href="/dashboard">

                        🏠 Dashboard

                    </a>

                    <a href="/profile">

                        👤 Profile

                    </a>

                    <a href="/listings/my-listings">

                        📦 My Listings

                    </a>

                    <a href="/leases/my-requests">

                        📝 My Requests

                    </a>

                    <a href="/leases/owner">

                        📑 Incoming Requests

                    </a>

                    <a href="/messages">

                        💬 Messages

                    </a>

                    <hr>

                    <form action="/auth/logout" method="POST">
                        <button type="submit" class="dropdown-menu-action">
                            🚪 Logout
                        </button>
                    </form>

                </div>

            </div>

        </div>

        <% } else { %>

        <div class="guest-buttons">

            <a href="/login" class="secondary-btn">

                Login

            </a>

            <a href="/register" class="primary-btn">

                Sign Up

            </a>

        </div>

        <% } %>

    </div>

</nav>